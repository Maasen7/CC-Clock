-- fancy_clock.lua

local monitorSide = "top"
local swedenOffset = 2 -- UTC+2 summer, UTC+1 winter

local mon = peripheral.wrap(monitorSide)
if not mon or peripheral.getType(monitorSide) ~= "monitor" then
    error("No monitor found on side: " .. monitorSide)
end

mon.setTextScale(1)

local screen = "menu"

local function clear(bg)
    mon.setBackgroundColor(bg or colors.black)
    mon.setTextColor(colors.white)
    mon.clear()
    mon.setCursorPos(1, 1)
end

local function size()
    return mon.getSize()
end

local function center(y, text, fg, bg)
    local w = size()
    mon.setTextColor(fg or colors.white)
    mon.setBackgroundColor(bg or colors.black)
    mon.setCursorPos(math.floor((w - #text) / 2) + 1, y)
    mon.write(text)
end

local function bar(y, text, bg, fg)
    local w = size()
    mon.setBackgroundColor(bg)
    mon.setTextColor(fg or colors.white)
    mon.setCursorPos(2, y)
    mon.write(string.rep(" ", w - 2))
    center(y, text, fg or colors.white, bg)
    mon.setBackgroundColor(colors.black)
end

local function button(y, text, bg)
    bar(y, "  " .. text .. "  ", bg or colors.gray, colors.white)
end

local function frame(title)
    local w, h = size()
    clear(colors.black)

    mon.setBackgroundColor(colors.blue)
    mon.setTextColor(colors.white)
    mon.setCursorPos(1, 1)
    mon.write(string.rep(" ", w))
    center(1, title, colors.white, colors.blue)

    mon.setBackgroundColor(colors.gray)
    mon.setCursorPos(1, h)
    mon.write(string.rep(" ", w))
    center(h, "Touch buttons to control", colors.white, colors.gray)
end

local function drawMenu()
    local w, h = size()
    frame("CLOCK CONTROL")

    center(3, "Select Mode", colors.yellow)
    button(6, "Minecraft Time", colors.green)
    button(9, "Real Life Time", colors.cyan)
    button(12, "Exit", colors.red)

    center(h - 2, "3x3 Monitor Ready", colors.lightGray)
end

local function realTime()
    return textutils.formatTime(os.time("utc") + swedenOffset, true)
end

local function drawClock(title, timeText, bgColor)
    local w, h = size()
    frame(title)

    center(4, "====================", colors.lightGray)
    center(6, timeText, colors.yellow)
    center(8, "====================", colors.lightGray)

    button(h - 3, "Back", bgColor or colors.gray)
end

while true do
    if screen == "menu" then
        drawMenu()

        local event, side, x, y = os.pullEvent("monitor_touch")
        if side == monitorSide then
            if y >= 6 and y <= 6 then
                screen = "ingame"
            elseif y >= 9 and y <= 9 then
                screen = "realtime"
            elseif y >= 12 and y <= 12 then
                clear()
                center(5, "Goodbye!", colors.yellow)
                break
            end
        end

    elseif screen == "ingame" then
        drawClock("MINECRAFT TIME", textutils.formatTime(os.time("ingame"), true), colors.green)

        local timer = os.startTimer(0.5)
        local event, side, x, y = os.pullEvent()

        local w, h = size()
        if event == "monitor_touch" and side == monitorSide and y == h - 3 then
            screen = "menu"
        end

    elseif screen == "realtime" then
        drawClock("REAL LIFE TIME", realTime(), colors.cyan)

        local timer = os.startTimer(0.5)
        local event, side, x, y = os.pullEvent()

        local w, h = size()
        if event == "monitor_touch" and side == monitorSide and y == h - 3 then
            screen = "menu"
        end
    end
end
