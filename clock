-- clock_touch.lua

local monitorSide = "top"
local swedenOffset = 2

local mon = peripheral.wrap(monitorSide)
if not mon or peripheral.getType(monitorSide) ~= "monitor" then
    error("No monitor found on side: " .. monitorSide)
end

mon.setTextScale(1)

local function clear()
    mon.setBackgroundColor(colors.black)
    mon.setTextColor(colors.white)
    mon.clear()
    mon.setCursorPos(1, 1)
end

local function center(y, text)
    local w = mon.getSize()
    mon.setCursorPos(math.floor((w - #text) / 2) + 1, y)
    mon.write(text)
end

local function button(y, text)
    local w = mon.getSize()
    mon.setCursorPos(3, y)
    mon.setBackgroundColor(colors.gray)
    mon.setTextColor(colors.white)
    mon.write(string.rep(" ", w - 4))
    mon.setCursorPos(math.floor((w - #text) / 2) + 1, y)
    mon.write(text)
    mon.setBackgroundColor(colors.black)
end

local function drawMenu()
    clear()
    center(1, "Clock Menu")
    center(2, "==========")
    button(5, "Minecraft Time")
    button(7, "Real Life Time")
    button(9, "Exit")
end

local function drawClock(title, timeText)
    clear()
    center(1, title)
    center(3, timeText)
    button(6, "Back")
end

local function realTime()
    return textutils.formatTime(os.time("utc") + swedenOffset, true)
end

local screen = "menu"

while true do
    if screen == "menu" then
        drawMenu()

        local event, side, x, y = os.pullEvent("monitor_touch")

        if side == monitorSide then
            if y == 5 then
                screen = "ingame"
            elseif y == 7 then
                screen = "realtime"
            elseif y == 9 then
                clear()
                center(3, "Goodbye!")
                break
            end
        end

    elseif screen == "ingame" then
        drawClock("Minecraft Time", textutils.formatTime(os.time("ingame"), true))

        local timer = os.startTimer(0.5)
        local event, p1, x, y = os.pullEvent()

        if event == "monitor_touch" and p1 == monitorSide and y == 6 then
            screen = "menu"
        end

    elseif screen == "realtime" then
        drawClock("Real Life Time", realTime())

        local timer = os.startTimer(0.5)
        local event, p1, x, y = os.pullEvent()

        if event == "monitor_touch" and p1 == monitorSide and y == 6 then
            screen = "menu"
        end
    end
end
