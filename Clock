-- clock.lua

local function clear()
    term.clear()
    term.setCursorPos(1, 1)
end

local function showClock(mode)
    while true do
        clear()

        if mode == "ingame" then
            print("Minecraft Time")
            print("==============")
            print(textutils.formatTime(os.time("ingame"), true))

        elseif mode == "sweden" then
            print("Sweden Time")
            print("===========")
            print(textutils.formatTime(os.time("local"), true))
        end

        print()
        print("Press Q to go back")

        local event, key = os.pullEvent()

        if event == "key" and key == keys.q then
            break
        end
    end
end

while true do
    clear()

    print("Clock Menu")
    print("==========")
    print("1. Minecraft in-game time (24h)")
    print("2. Real life Sweden clock")
    print("3. Exit")
    print()
    write("Choose: ")

    local choice = read()

    if choice == "1" then
        showClock("ingame")
    elseif choice == "2" then
        showClock("sweden")
    elseif choice == "3" then
        clear()
        print("Goodbye!")
        break
    end
end
