-- CONFIG
local monitorSide = "top" -- change this if needed

local output = term
if peripheral.isPresent(monitorSide) and peripheral.getType(monitorSide) == "monitor" then
    output = peripheral.wrap(monitorSide)
    output.setTextScale(1)
else
    print("No monitor found on side: " .. monitorSide)
    print("Using computer screen instead.")
    sleep(2)
end

local function clear(t)
    t.setBackgroundColor(colors.black)
    t.setTextColor(colors.white)
    t.clear()
    t.setCursorPos(1, 1)
end

local function writeLines(t, title, timeText)
    clear(t)
    t.write(title)
    t.setCursorPos(1, 2)
    t.write(string.rep("=", #title))
    t.setCursorPos(1, 4)
    t.write(timeText)
end

local function swedenTime()
    -- Sweden summer time: UTC+2
    -- Change +2 to +1 during winter time
    return textutils.formatTime(os.time("utc") + 2, true)
end

while true do
    clear(term)
    print("Clock Menu")
    print("==========")
    print("1. Minecraft in-game time (24h)")
    print("2. Real life Sweden clock")
    print("3. Exit")
    print()
    write("Choose: ")

    local choice = read()

    if choice == "1" then
        while true do
            writeLines(output, "Minecraft Time", textutils.formatTime(os.time("ingame"), true))
            sleep(0.5)
        end

    elseif choice == "2" then
        while true do
            writeLines(output, "Sweden Time", swedenTime())
            sleep(0.5)
        end

    elseif choice == "3" then
        clear(output)
        clear(term)
        print("Goodbye!")
        break
    end
end
